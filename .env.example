# Copy to .env.local and fill in to enable the quote request form's
# email sending. See README.md for details.

RESEND_API_KEY=
QUOTE_FROM_EMAIL="Four Points Surveyors <quotes@yourdomain.com>"
QUOTE_NOTIFY_EMAIL=

# Optional: logs each quote request as a row in a Google Sheet, in
# addition to the email above. See README.md "Google Sheets logging"
# for how to get these three values.
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_KEY=
