# Copy to .env.local and fill in to enable the quote request form's
# email sending. See README.md for details.

RESEND_API_KEY=
QUOTE_FROM_EMAIL="Four Points Surveyors <quotes@yourdomain.com>"
QUOTE_NOTIFY_EMAIL=

# Optional: logs each quote request as a row in a Google Sheet, in
# addition to the email above. See README.md "Google Sheets logging"
# for how to get these three values.
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_KEY=

# Quote-to-work-order automation (admin page + customer e-signature
# flow). Without these, /admin simply isn't reachable. See README.md
# "Quote-to-work-order automation" for details.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
WORK_ORDER_TOKEN_SECRET=

# Online payment via PayPal (card, PayPal, or Venmo). Without these,
# the "Pay now" form on /payments simply doesn't render - the rest of
# the site works fine either way. See README.md "Online payment" for
# details. PAYPAL_CLIENT_ID and NEXT_PUBLIC_PAYPAL_CLIENT_ID should be
# the same value - Client IDs aren't secret, the public one is what
# lets the PayPal buttons render in the customer's browser.
PAYPAL_CLIENT_ID=
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
